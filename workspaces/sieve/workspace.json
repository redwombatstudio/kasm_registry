{
  "name": "ksonney/sieve-editor:latest",
  "description": "Sieve Script Editor",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "sieve.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Email"
  ],
  "friendly_name": "Sieve Manager",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ksonney/sieve-editor",
      "uncompressed_size_mb": 2170,
      "available_tags": [
        "latest",
	"main"
      ]
    }
  ]
}
