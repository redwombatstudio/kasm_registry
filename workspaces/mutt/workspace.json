{
  "name": "ksonney/mutt:latest",
  "description": "Mutt is an email client that sucks less than others",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "muttlogo.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Email"
  ],
  "friendly_name": "Mutt",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "ksonney/mutt",
      "uncompressed_size_mb": 2170,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
